rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }

    function isSubAdmin() {
      return isSignedIn() && userDoc().data.role == 'sub-admin';
    }

    function isActiveAccount() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        !('accountStatus' in userDoc().data) ||
        userDoc().data.accountStatus != 'deactivated'
      );
    }

    function ownsOrder() {
      return isSignedIn() &&
        resource.data.buyerEmail == request.auth.token.email;
    }

    function createsOwnOrder() {
      return isSignedIn() &&
        request.resource.data.buyerEmail == request.auth.token.email &&
        request.resource.data.status in ['pending', 'paid'];
    }

    function hasAnalyticsOrderFields(data) {
      return ('createdAt' in data) &&
        ('total' in data) &&
        ('items' in data) &&
        data.createdAt is timestamp &&
        data.total is number &&
        data.total >= 0 &&
        data.items is list &&
        data.items.size() > 0;
    }

    function completedTransitionHasAnalyticsFields() {
      return !(resource.data.status != 'completed' &&
        request.resource.data.status == 'completed') ||
        hasAnalyticsOrderFields(request.resource.data);
    }

    function hasCurrentAdminDataQualityReview() {
      return isAdmin() &&
        ('dataQualityReview' in resource.data) &&
        resource.data.dataQualityReview.reviewedBy == request.auth.uid &&
        resource.data.dataQualityReview.reviewedAt != null;
    }

    // Main admins may continue the existing status workflows, but cannot
    // directly edit financial, buyer, inventory, or future archive fields.
    function updatesAdminOrderWorkflow() {
      return isAdmin() &&
        completedTransitionHasAnalyticsFields() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'reviewedAt',
          'declinedAt',
          'cancelledAt',
          'cancelledBy',
          'refundedAt'
        ]);
    }

    // A data-quality review is recorded once, by the main admin who performed
    // it. Archive/restore fields remain denied until their audited batch flow
    // is added in the next Phase 5 step.
    function recordsDataQualityReview() {
      return isAdmin() &&
        !hasAnalyticsOrderFields(resource.data) &&
        !('dataQualityReview' in resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['dataQualityReview', 'updatedAt']) &&
        request.resource.data.dataQualityReview.keys()
          .hasOnly(['reviewedBy', 'reviewedAt']) &&
        request.resource.data.dataQualityReview.reviewedBy == request.auth.uid &&
        request.resource.data.dataQualityReview.reviewedAt == request.time;
    }

    function hasArchivableStatus() {
      return resource.data.status in ['completed', 'declined', 'cancelled', 'Refunded'];
    }

    function isAuditReason(value) {
      return value is string && value.size() >= 10 && value.size() <= 500;
    }

    function isArchiveMap(value) {
      return value.keys().hasOnly([
        'isArchived',
        'archivedAt',
        'archivedBy',
        'reason',
        'restoredAt',
        'restoredBy',
        'restoreReason',
        'lastLifecycleAuditId'
      ]);
    }

    function hasMatchingLifecycleAudit(orderId, action, reason) {
      let auditId = request.resource.data.archive.lastLifecycleAuditId;
      let audit = getAfter(/databases/$(database)/documents/orderLifecycleAudits/$(auditId)).data;
      return auditId is string &&
        audit.keys().hasOnly([
          'orderId',
          'action',
          'previousStatus',
          'actorUid',
          'occurredAt',
          'reason'
        ]) &&
        audit.orderId == orderId &&
        audit.action == action &&
        audit.previousStatus == resource.data.status &&
        audit.actorUid == request.auth.uid &&
        audit.occurredAt == request.time &&
        audit.reason == reason;
    }

    function archivesOrder(orderId) {
      let archive = request.resource.data.archive;
      return isAdmin() &&
        hasArchivableStatus() &&
        (!('archive' in resource.data) || resource.data.archive.isArchived != true) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archive', 'updatedAt']) &&
        isArchiveMap(archive) &&
        archive.isArchived == true &&
        archive.archivedBy == request.auth.uid &&
        archive.archivedAt == request.time &&
        isAuditReason(archive.reason) &&
        archive.restoredAt == null &&
        archive.restoredBy == null &&
        archive.restoreReason == '' &&
        hasMatchingLifecycleAudit(orderId, 'archived', archive.reason);
    }

    function restoresOrder(orderId) {
      let archive = request.resource.data.archive;
      return isAdmin() &&
        ('archive' in resource.data) &&
        resource.data.archive.isArchived == true &&
        hasArchivableStatus() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archive', 'updatedAt']) &&
        isArchiveMap(archive) &&
        archive.isArchived == false &&
        archive.archivedAt == resource.data.archive.archivedAt &&
        archive.archivedBy == resource.data.archive.archivedBy &&
        archive.reason == resource.data.archive.reason &&
        archive.restoredBy == request.auth.uid &&
        archive.restoredAt == request.time &&
        isAuditReason(archive.restoreReason) &&
        hasMatchingLifecycleAudit(orderId, 'restored', archive.restoreReason);
    }

    function createsLifecycleAudit(auditId) {
      let audit = request.resource.data;
      let orderAfter = getAfter(/databases/$(database)/documents/orders/$(audit.orderId)).data;
      return isAdmin() &&
        audit.orderId is string &&
        audit.action in ['archived', 'restored'] &&
        audit.previousStatus is string &&
        audit.actorUid == request.auth.uid &&
        audit.occurredAt == request.time &&
        isAuditReason(audit.reason) &&
        audit.keys().hasOnly([
          'orderId',
          'action',
          'previousStatus',
          'actorUid',
          'occurredAt',
          'reason'
        ]) &&
        orderAfter.archive.lastLifecycleAuditId == auditId &&
        orderAfter.status == audit.previousStatus &&
        (
          (audit.action == 'archived' &&
            orderAfter.archive.isArchived == true &&
            orderAfter.archive.archivedBy == request.auth.uid &&
            orderAfter.archive.archivedAt == request.time &&
            orderAfter.archive.reason == audit.reason) ||
          (audit.action == 'restored' &&
            orderAfter.archive.isArchived == false &&
            orderAfter.archive.restoredBy == request.auth.uid &&
            orderAfter.archive.restoredAt == request.time &&
            orderAfter.archive.restoreReason == audit.reason)
        );
    }

    function hasReviewedInvalidDataQualityRecord() {
      return !hasAnalyticsOrderFields(resource.data) &&
        !(resource.data.status in [
          'paid',
          'payment_confirmed',
          'processing',
          'shipping',
          'completed',
          'Refunded'
        ]) &&
        !('paidAt' in resource.data) &&
        !('paymentId' in resource.data) &&
        ('dataQualityReview' in resource.data) &&
        resource.data.dataQualityReview.keys().hasOnly(['reviewedBy', 'reviewedAt']) &&
        resource.data.dataQualityReview.reviewedBy == request.auth.uid &&
        resource.data.dataQualityReview.reviewedAt is timestamp;
    }

    function hasMatchingDeletionAudit(orderId) {
      let audit = getAfter(/databases/$(database)/documents/orderDeletionAudits/$(orderId)).data;
      return audit.keys().hasOnly([
          'orderId',
          'action',
          'previousStatus',
          'actorUid',
          'occurredAt',
          'reason',
          'reviewedBy',
          'reviewedAt'
        ]) &&
        audit.orderId == orderId &&
        audit.action == 'permanently_deleted' &&
        audit.previousStatus == resource.data.status &&
        audit.actorUid == request.auth.uid &&
        audit.occurredAt == request.time &&
        isAuditReason(audit.reason) &&
        audit.reviewedBy == resource.data.dataQualityReview.reviewedBy &&
        audit.reviewedAt == resource.data.dataQualityReview.reviewedAt;
    }

    function deletesReviewedInvalidOrder(orderId) {
      return isAdmin() &&
        hasReviewedInvalidDataQualityRecord() &&
        hasMatchingDeletionAudit(orderId);
    }

    function createsDeletionAudit(auditId) {
      let audit = request.resource.data;
      let orderBefore = get(/databases/$(database)/documents/orders/$(audit.orderId)).data;
      return isAdmin() &&
        auditId == audit.orderId &&
        audit.keys().hasOnly([
          'orderId',
          'action',
          'previousStatus',
          'actorUid',
          'occurredAt',
          'reason',
          'reviewedBy',
          'reviewedAt'
        ]) &&
        audit.action == 'permanently_deleted' &&
        audit.previousStatus == orderBefore.status &&
        audit.actorUid == request.auth.uid &&
        audit.occurredAt == request.time &&
        isAuditReason(audit.reason) &&
        !hasAnalyticsOrderFields(orderBefore) &&
        !(orderBefore.status in [
          'paid',
          'payment_confirmed',
          'processing',
          'shipping',
          'completed',
          'Refunded'
        ]) &&
        !('paidAt' in orderBefore) &&
        !('paymentId' in orderBefore) &&
        ('dataQualityReview' in orderBefore) &&
        orderBefore.dataQualityReview.keys().hasOnly(['reviewedBy', 'reviewedAt']) &&
        orderBefore.dataQualityReview.reviewedBy == request.auth.uid &&
        audit.reviewedBy == orderBefore.dataQualityReview.reviewedBy &&
        audit.reviewedAt == orderBefore.dataQualityReview.reviewedAt &&
        !existsAfter(/databases/$(database)/documents/orders/$(audit.orderId));
    }

    function buyerUpdatesPaymentReference() {
      return isActiveAccount() && ownsOrder() &&
        resource.data.status == 'paid' &&
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['paymentId', 'paidAt']);
    }

    function buyerRequestsCancellation() {
      return isActiveAccount() && ownsOrder() &&
        resource.data.status in [
          'pending',
          'pending_review',
          'on_review',
          'Paid / Processing'
        ] &&
        request.resource.data.status == 'Cancellation Requested' &&
        request.resource.data.cancellationRequestedBy == 'buyer' &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'cancelReason',
          'cancellationRequestedAt',
          'cancellationRequestedBy'
        ]);
    }

    match /users/{userId} {
      // Registration creates a profile for the authenticated account only.
      // The app currently uses both customer and buyer as non-privileged roles.
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role in ['customer', 'buyer'] &&
        request.resource.data.accountStatus == 'active' &&
        request.resource.data.hasApprovedOrders == false;

      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isSubAdmin()
      );

      allow update: if (
        isSignedIn() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).changedKeys().hasAny([
          'role',
          'promotedBy',
          'promotedAt',
          'removedBy',
          'removedAt',
          'updatedAt',
          'hasApprovedOrders',
          'approvedOrderAt',
          'accountStatus',
          'deactivatedAt'
        ])
      ) || (
        isSignedIn() &&
        request.auth.uid == userId &&
        resource.data.hasApprovedOrders == false &&
        request.resource.data.hasApprovedOrders == false &&
        resource.data.accountStatus == 'active' &&
        request.resource.data.accountStatus == 'deactivated' &&
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['accountStatus', 'deactivatedAt'])
      ) || (
        isSubAdmin() &&
        request.resource.data.hasApprovedOrders == true &&
        request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['hasApprovedOrders', 'approvedOrderAt'])
      ) || isAdmin();

      allow delete: if (isSignedIn() && request.auth.uid == userId &&
        resource.data.hasApprovedOrders == false) || isAdmin();

      match /cart/{itemId} {
        allow read, write: if isActiveAccount() && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read, write: if isActiveAccount() && (
          request.auth.uid == userId || isAdmin()
        );
      }
    }

    match /pricelists/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() || isSubAdmin();
      allow delete: if isAdmin();
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Preserved pending a separate review-workflow decision. Signed-in writes
    // remain compatible with the existing review and admin-reply behavior.
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isActiveAccount();
    }

    match /orders/{orderId} {
      allow create: if isActiveAccount() && createsOwnOrder() &&
        hasAnalyticsOrderFields(request.resource.data);

      allow read: if isSignedIn() && (
        (isActiveAccount() && resource.data.buyerEmail == request.auth.token.email) ||
        isAdmin() ||
        isSubAdmin()
      );

      allow update: if updatesAdminOrderWorkflow() ||
        recordsDataQualityReview() ||
        archivesOrder(orderId) ||
        restoresOrder(orderId) ||
        buyerUpdatesPaymentReference() ||
        buyerRequestsCancellation() ||
        (
          isSubAdmin() &&
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status in [
            'on_review',
            'payment_confirmed',
            'processing',
            'shipping'
          ]
        );

      allow delete: if deletesReviewedInvalidOrder(orderId);
    }

    match /orderLifecycleAudits/{auditId} {
      allow read: if isAdmin();
      allow create: if createsLifecycleAudit(auditId);
      allow update, delete: if false;
    }

    match /orderDeletionAudits/{orderId} {
      allow read: if isAdmin();
      allow create: if createsDeletionAudit(orderId);
      allow update, delete: if false;
    }

    match /messages/{messageId} {
      allow read: if isAdmin() || isSubAdmin() || (
        isActiveAccount() && resource.data.buyerEmail == request.auth.token.email
      );

      allow create: if (
          isActiveAccount() &&
        request.resource.data.buyerEmail == request.auth.token.email &&
        request.resource.data.isAdminReply == false
      ) || (
        (isAdmin() || isSubAdmin()) &&
        request.resource.data.isAdminReply == true
      );

      allow update: if (
        isAdmin() ||
        isSubAdmin() ||
          (isActiveAccount() && resource.data.buyerEmail == request.auth.token.email)
      ) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['read', 'unread'];

      allow delete: if isAdmin();
    }

    // Daily summaries are server-maintained. Admin dashboards may read the
    // compact reports; no browser client may write them or the event log.
    match /analyticsDaily/{dayId} {
      allow read: if isAdmin() || isSubAdmin();
      allow write: if false;
    }

    match /analyticsEventLog/{eventId} {
      allow read, write: if false;
    }
  }
}
